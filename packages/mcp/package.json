{
  "name": "gmermaid",
  "version": "2026.817.0",
  "description": "Local GUI editor and MCP review server for Mermaid diagrams",
  "license": "MIT",
  "keywords": ["mcp", "mermaid", "diagram", "editor", "llm"],
  "homepage": "https://github.com/Mr-akami/gMermaid#readme",
  "bugs": {
    "url": "https://github.com/Mr-akami/gMermaid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-akami/gMermaid.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "bin": {
    "gmermaid": "dist/cli.js",
    "gmermaid-mcp": "dist/cli.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "vite build && vite build --config vite.editor.config.ts && tsup",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "open": "^10.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@gmermaid/app": "workspace:*",
    "@gmermaid/mermaid-parser": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" }
}
